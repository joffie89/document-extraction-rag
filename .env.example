ENVIRONMENT=production
APP_NAME="Document Extraction RAG"
API_PREFIX=/api/v1
CORS_ORIGINS='["http://localhost:5173"]'
DATABASE_URL=sqlite:///./data/document_rag.db
UPLOAD_DIRECTORY=./data/uploads
MARKDOWN_DIRECTORY=./data/markdown
CHROMA_DIRECTORY=./data/chroma
CHROMA_COLLECTION=document_chunks
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
GENERATION_MODEL=gpt-4.1-mini
OCR_LANGUAGE=en
MAX_UPLOAD_BYTES=52428800
MAX_DOCUMENT_PAGES=500
EXTRACTION_TIMEOUT_SECONDS=300
OPENAI_TIMEOUT_SECONDS=60
SEMANTIC_BREAK_PERCENTILE=80
MIN_CHUNK_TOKENS=100
MAX_CHUNK_TOKENS=800
RAG_TOP_K=5
RAG_RETRIEVAL_MODE=embedding
RAG_RRF_K=60
RAG_HYBRID_CANDIDATE_MULTIPLIER=4
RAG_DOCUMENT_HINT_MODE=none
RAG_STRICT_GROUNDING=false
LOG_LEVEL=INFO
